// =============================================================================
//  claude-sandbox devcontainer  (piloted from Claude-Sandbox/devcontainer-template)
//
//  Reproducible-dev mode: in VSCode run "Dev Containers: Reopen in Container".
//  Inside, run `claude` normally in the integrated terminal (manual/Auto
//  approvals) — interactive-with-approvals, NOT the autonomous YOLO wrapper.
//
//  PREREQUISITE (one-time, already set in your VSCode settings.json):
//      "dev.containers.dockerPath": "podman"
//
//  Mounts this project folder, your ~/.claude (login + skills + memory), and
//  NCDPI-Warehouse + NCDPI-Data-Visualization (read-only). Nothing else on the host is visible. NEVER add a mount for
//  OneDrive/SharePoint, C:\Users\AndyBaxter\Data, or G:\My Drive\EPP Codebase.
// =============================================================================
{
  "name": "claude-sandbox",
  "image": "localhost/claude-sandbox:latest",
  "workspaceFolder": "/home/vscode/work",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/vscode/work,type=bind",
  "mounts": [
    "source=${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind",
    // Plugins dir is container-local (named volume), NOT shared from the host. The
    // host's ~/.claude/plugins JSON records Windows absolute paths (C:\Users\...),
    // which this Linux container can't resolve — that leakage silently breaks the
    // plugins subsystem (e.g. /plugin install failing, figma/code-review not loading).
    // Canonical source: Claude-Sandbox/devcontainer-template (change-spec item C3).
    "source=claude-sandbox-plugins,target=/home/vscode/.claude/plugins,type=volume",
    // Keep Codex login and settings Linux-native and isolated to this project.
    "source=${devcontainerId}-codex,target=/home/vscode/.codex,type=volume",
    // gh + wrangler logins. SHARED volumes (fixed names), not ${devcontainerId}
    // per-project ones: a GitHub or Cloudflare login is account-level, not
    // project-level, so a per-project volume would mean re-running `gh auth login`
    // in every repo's container for no benefit. Authenticate once, persists
    // everywhere, survives rebuilds.
    "source=claude-sandbox-gh,target=/home/vscode/.config/gh,type=volume",
    "source=claude-sandbox-wrangler,target=/home/vscode/.config/.wrangler,type=volume",
    // NCDPI-Warehouse, READ-ONLY, so this repo's sessions can read the warehouse's
    // documentation, table definitions and built tables (repos almost always need
    // warehouse data). Same ${localEnv:USERPROFILE} form as the ~/.claude mount, so it
    // resolves identically on the laptop and the desktop. Read-only on purpose:
    // deliverables are built in their own repo, never across repos. Whatever gitignored
    // DATA sits in that folder on the host is visible here too (Andy accepted that
    // 2026-10-22). Reaches the container only after a rebuild; verify with:
    //   ls /home/vscode/NCDPI-Warehouse
    "source=${localEnv:USERPROFILE}/Projects/NCDPI-Warehouse,target=/home/vscode/NCDPI-Warehouse,type=bind,readonly",
    // NCDPI-Data-Visualization, READ-ONLY, so chart work in this repo uses the live
    // brand palette, chart conventions and chart_helpers.py instead of the older copies
    // bundled in the chart-creator skill (which probes this path first). Read-only on
    // purpose: changes to the viz repo happen in its own session (added 2026-10-22).
    // Verify after a rebuild with: ls /home/vscode/NCDPI-Data-Visualization
    "source=${localEnv:USERPROFILE}/Projects/NCDPI-Data-Visualization,target=/home/vscode/NCDPI-Data-Visualization,type=bind,readonly"
  ],
  // Cloudflare's OAuth flow redirects to a callback server on localhost:8976.
  // Without this forward the browser can't reach it and `wrangler login` just
  // hangs forever. You must ALSO run it as:
  //     wrangler login --callback-host=0.0.0.0
  // so wrangler listens on all interfaces inside the container, not just its own
  // loopback. This is the #1 reason wrangler login "does nothing" in a container.
  "forwardPorts": [8976],
  // Rootless-Podman recipe. --userns=keep-id maps your host user (uid 1000) to
  // the container's vscode user, so the VS Code Server volume (/vscode, mounted
  // external=true with no copy-up) and the bind mounts are owned correctly.
  // Without it they appear root-owned and setup dies with "Permission denied".
  // NOTE: --cap-drop=ALL is intentionally omitted here — it blocks the chown the
  // extension's setup performs. The autonomous wrapper keeps full hardening;
  // here, rootless + the strict mount list is the isolation boundary.
  "runArgs": ["--userns=keep-id", "--security-opt=no-new-privileges"],
  "remoteUser": "vscode",
  // Skip the startup UID auto-remap — under rootless Podman that chown/usermod
  // step fails. keep-id (above) already handles user/ownership mapping.
  "updateRemoteUserUID": false,
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "openai.chatgpt",
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
